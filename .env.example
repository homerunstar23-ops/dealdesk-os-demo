# DealDesk OS configuration. Copy to .env (chmod 600) or run `npm run setup` to generate one.
PORT=4100
HOST=127.0.0.1                 # keep 127.0.0.1 behind Cloudflare Tunnel / a reverse proxy
NODE_ENV=production
APP_TZ=America/New_York
SESSION_SECRET=change-me-64-hex-chars
ADMIN_EMAIL=you@example.com    # only used to create the FIRST admin
ADMIN_NAME=Cory Jones
ADMIN_PASSWORD=change-me-12+chars
SEED_DEMO=1                    # 1 = load clearly-labeled fake DEMO data once; 0 = start empty
COOKIE_SECURE=0                # set 1 when served over HTTPS (Cloudflare Tunnel, etc.)
TRUST_PROXY=0                  # set 1 when behind a proxy/tunnel so client IPs + secure cookies work
DB_FILE=./data/dealdesk.db
UPLOAD_DIR=./data/uploads      # outside the web root; never served publicly
MAX_UPLOAD_MB=15
UPLOAD_LINK_DAYS=14
LOGIN_MAX_ATTEMPTS=10          # per 15 minutes per IP
INTAKE_MAX_PER_HOUR=20         # public form submissions per hour per IP
# STRIPE_SECRET_KEY=sk_test_... # TEST mode only in v1; live keys are refused by the app
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---- v2 automation / outbound messaging (see docs/SENDING.md) ----
SCHEDULER=1                    # in-app scheduler (node-cron, every minute); 0 = off
OUTBOUND_DRY_RUN=1             # 1 = never really send (simulate + log). Remove only after broker approval.
# Email (any SMTP provider; nothing is sent unless all four are set AND OUTBOUND_DRY_RUN is not 1)
# SMTP_HOST=smtp.gmail.com     # Gmail: smtp.gmail.com:587 + an app password (needs 2-Step Verification)
# SMTP_PORT=587                # Brevo: smtp-relay.brevo.com:587 · Resend: smtp.resend.com:465 (user "resend", pass = API key)
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=app-password-or-api-key
# MAIL_FROM="Cory Jones <you@yourdomain.com>"
# SMS (OPTIONAL, PAID — Twilio per-message + A2P 10DLC registration fees)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...        # also used to verify the inbound /webhooks/sms signature (STOP handling)
# TWILIO_FROM=+15615550000     # or TWILIO_MESSAGING_SERVICE_SID=MG...
